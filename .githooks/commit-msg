#!/bin/sh
IFS= read -r subject < "$1"
case "$subject" in
  feat:*|fix:*|docs:*|refactor:*|perf:*|test:*|build:*|chore:*|\
  feat\(*\):*|fix\(*\):*|docs\(*\):*|refactor\(*\):*|perf\(*\):*|\
  test\(*\):*|build\(*\):*|chore\(*\):*) ;;
  *)
    echo 'Commit subject must match: type(scope): summary' >&2
    exit 1
    ;;
esac
case "$subject" in
  *': '?*) ;;
  *)
    echo 'Commit summary must follow a colon and space' >&2
    exit 1
    ;;
esac
